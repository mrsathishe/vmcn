# Mail API (https://mail.satz.co.in)
# Copy to .env and fill in the key. .env is gitignored.
#
# WARNING: Vite inlines VITE_* values into the built JS bundle, so this key is
# readable by anyone who views the deployed site. Use a key that is restricted
# to this site's origin on the server side.
VITE_MAIL_API_KEY=
VITE_MAIL_API_URL=https://mail.satz.co.in/api/v1/send
